{
  "cli": {
    "version": ">= 27.7.2",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_GUARDIAN_DEVICE_QA": "1",
        "EXPO_PUBLIC_WORLD_COLLISION_QA": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_GUARDIAN_DEVICE_QA": "1",
        "EXPO_PUBLIC_WORLD_COLLISION_QA": "1",
        "STAAR_IPHONE_ONLY_QA": "1"
      }
    },
    "production": {
      "distribution": "store",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://cross-life-ai.emergent.host",
        "EXPO_PUBLIC_GUARDIAN_DEVICE_QA": "0",
        "EXPO_PUBLIC_WORLD_COLLISION_QA": "0"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6834467523"
      }
    }
  }
}
